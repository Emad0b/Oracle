OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: set this for OpenAI-compatible providers.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google OAuth (Gmail + Calendar)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback
APP_BASE_URL=http://127.0.0.1:8000

# Text UI
ORACLE_HUD=1
WHISPER_MODEL=whisper-1
SPEECH_VOICE=nova
# VISION_MODEL must support image inputs; defaults to OPENAI_MODEL.
# VISION_MODEL=gpt-4o-mini
# MIC_DEVICE=0

# IoT: demo works without hardware; live mode is opt-in.
IOT_BACKEND=demo
# IOT_BACKEND=home_assistant
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=your_local_home_assistant_token
# HA_ALLOWED_ENTITIES=light.study,switch.desk_lamp
